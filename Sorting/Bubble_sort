def bubble_sort(arr):
    n=len(arr)
    for i in range(n-1):
        swapped=False
        for j in range(n-i-1):
            if arr[j]>arr[j+1]:
                arr[j],arr[j+1]=arr[j+1],arr[j]
                swapped=True
        print(f"After Pass {i+1}: {arr}")
        if not swapped:
            break
    return arr
nums = [1, 2, 3, 5, 4]
result=bubble_sort(nums)
print(result)